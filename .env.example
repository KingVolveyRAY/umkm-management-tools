# Node.js 24+
PORT=5173
# Neon pooled connection string. When set, this takes precedence over DB_PATH.
# DATABASE_URL=
# DB_PATH=data/kelola.sqlite
# Required when initializing a new database (password 12–128 characters).
# OWNER_USERNAME=
# OWNER_PASSWORD=
# Midtrans Core API. Leave the key unset to disable dynamic QRIS.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_PRODUCTION=0
# Set this when the public app uses HTTPS.
# COOKIE_SECURE=1
# Set only behind a trusted, one-hop reverse proxy.
# TRUST_PROXY=1
