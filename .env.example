# Node.js 24+
PORT=5173
# Set DEMO_MODE=0 for operations with a separate database.
DEMO_MODE=1
# DB_PATH=data/kelola.sqlite
# Required only when initializing a new operational database.
# OWNER_USERNAME=
# OWNER_PASSWORD=
# Midtrans Core API. Leave the key unset to disable dynamic QRIS.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_PRODUCTION=0
# Set this when the public app uses HTTPS.
# COOKIE_SECURE=1
# Set only behind a trusted, one-hop reverse proxy.
# TRUST_PROXY=1
